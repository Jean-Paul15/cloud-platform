# Copier ce fichier en .env puis renseigner les valeurs.
# Le script scripts/generate-secrets.sh produit un .env avec des secrets aléatoires.
# Toutes les valeurs ci-dessous sont factices.

# --- Service d'authentification ---
JWT_SECRET=changeme_random_string_at_least_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- PostgreSQL (métadonnées : utilisateurs, projets, refresh tokens) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_random_password
POSTGRES_DB=dbaas_system
POSTGRES_HOST=postgres-sys
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:changeme_random_password@postgres-sys:5432/dbaas_system?schema=public

# --- MongoDB (routeur du cluster shardé) ---
MONGO_URI=mongodb://mongo-router:27017

# --- Réseau ---
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443
AUTH_SERVICE_URL=http://dbaas-auth:3000
ALLOWED_ORIGINS=http://localhost

# --- Logs ---
NODE_ENV=production
LOG_LEVEL=info
